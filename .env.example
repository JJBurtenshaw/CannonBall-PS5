#
# Copy this file to .env. The local .env file is ignored by Git and read by
# Make; keep application identity and release metadata in sce_sys/param.json.

PS5_HOST=192.168.1.100
FTP_PORT=2121
DEPLOY_FORMAT=folder
DEPLOY_DRY_RUN=0

# PACBREW_PACKAGES=sdl2 openssl
PACBREW_PACKAGES=sdl2
APP_DEFINITIONS=CANNONBALL_PS5 CANNONBALL_PS5_FASTBLIT CANNONBALL_PS5_BETA1A CANNONBALL_PS5_BETA1B CANNONBALL_PS5_BETA1B_POLISH CANNONBALL_PS5_BETA1B_SCOREFIX CANNONBALL_PS5_BETA1C CANNONBALL_PS5_BETA1C2 CANNONBALL_PS5_BETA1C3 SDL_MAIN_HANDLED CANNONBALL_PS5_NATIVE
APP_INCLUDE_PATHS=src/cannonball local-includes
APP_STATIC_ARCHIVES=local-libs/libSDL2.a
